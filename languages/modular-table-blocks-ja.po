#: build/index.js:1
#. translators: %d: number of non-origin cells containing blocks.
msgid ""
"Only the starting cell content will remain. Contents in %d other cell will "
"be deleted, including locked blocks. You can undo this change."
msgid_plural ""
"Only the starting cell content will remain. Contents in %d other cells will "
"be deleted, including locked blocks. You can undo this change."
msgstr[0] "起点セルの内容だけを残します。他の%d個のセルの内容は、ロックされたブロックも含めて削除します。この変更は元に戻せます。"

#: build/index.js:1
#. translators: 1: origin row, 2: origin column.
msgid "Start: row %1$d, column %2$d"
msgstr "起点：%1$d行目、%2$d列目"

#: build/index.js:1
#. translators: 1: row, 2: column of a cell whose contents will be deleted.
msgid "Delete contents: row %1$d, column %2$d"
msgstr "内容を削除：%1$d行目、%2$d列目"

#: build/index.js:1
#. translators: %d: number of additional cells whose contents will be deleted.
msgid "And %d more cell."
msgid_plural "And %d more cells."
msgstr[0] "ほか%d個のセル。"

#: build/index.js:1
msgid "The table changed. Close and reopen this dialog before merging."
msgstr "表が変更されました。結合するには、この画面を閉じて開き直してください。"

#: build/index.js:1
#: build/table-import.js:2
msgid "Cancel"
msgstr "キャンセル"

#: build/index.js:1
msgid "Back to range selection"
msgstr "範囲選択に戻る"

