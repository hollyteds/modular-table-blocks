msgid "Delete contents and merge"
msgstr "内容を削除して結合"

#: build/index.js:1
msgid "Merge cells"
msgstr "セルを結合"

#: build/index.js:1
msgid "Only complete cells within the same header or body section can be merged."
msgstr "見出しと本文をまたがず、セル全体を含む範囲で結合できます。"

