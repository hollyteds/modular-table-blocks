{
  "name": "modular-table-blocks",
  "version": "0.1.0",
  "private": true,
  "description": "Nested table blocks for the WordPress block editor (M0).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "i18n:pot": "wp-env run cli -- wp i18n make-pot /var/www/html/wp-content/plugins/modular-table-blocks /var/www/html/wp-content/plugins/modular-table-blocks/languages/modular-table-blocks.pot --include=modular-table-blocks.php,build --domain=modular-table-blocks",
    "i18n:mo": "wp-env run cli -- wp i18n make-mo /var/www/html/wp-content/plugins/modular-table-blocks/languages",
    "i18n:json": "wp-env run cli -- wp i18n make-json /var/www/html/wp-content/plugins/modular-table-blocks/languages --no-purge --pretty-print --use-map=/var/www/html/wp-content/plugins/modular-table-blocks/languages/map.json",
    "i18n:build": "npm run i18n:mo && npm run i18n:json",
    "check-types": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint src tests --ext .ts,.tsx",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss'",
    "test:unit": "wp-scripts test-unit-js --runInBand",
    "test:e2e": "playwright test",
    "env:start": "wp-env start",
    "env:start:latest": "wp-env start --config=.wp-env.latest.json",
    "test:e2e:latest": "playwright test --config=playwright.latest.config.ts",
    "test:php:latest": "wp-env --config=.wp-env.latest.json run cli php /var/www/html/wp-content/plugins/modular-table-blocks/tests/php/render.php",
    "env:stop": "wp-env stop",
    "env:cli": "wp-env run cli",
    "test:php": "wp-env run tests-cli php /var/www/html/wp-content/plugins/modular-table-blocks/tests/php/render.php"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/wordpress__block-editor": "^15.0.7",
    "@types/wordpress__blocks": "^15.10.2",
    "@types/wordpress__components": "^23.0.12",
    "@types/wordpress__data": "^6.0.2",
    "@types/wordpress__i18n": "^3.4.0",
    "@wordpress/block-editor": "^18.1.0",
    "@wordpress/blocks": "^16.2.0",
    "@wordpress/components": "^42.0.0",
    "@wordpress/data": "^10.57.0",
    "@wordpress/element": "^9.0.0",
    "@wordpress/env": "^11.17.0",
    "@wordpress/eslint-plugin": "^24.5.0",
    "@wordpress/i18n": "^6.30.0",
    "@wordpress/jest-preset-default": "^14.2.0",
    "@wordpress/scripts": "^35.0.0",
    "@wordpress/stylelint-config": "^23.42.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "stylelint-scss": "^6.14.0",
    "typescript": "5.9"
  }
}
